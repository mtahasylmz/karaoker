# ---------- Shared across services ----------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
GCS_BUCKET=annemusic-videos

# Shared stage bearer token. Stages deploy with open Cloud Run ingress
# (QStash can't mint GCP OIDC tokens for context.call) and verify this on
# POST /process instead. The orchestrator and apps/api send it; the stages
# check it. Unset = open (local dev). Generate: openssl rand -hex 32
# STAGE_AUTH_TOKEN=

# Dev-only: if set, both TS and Python halves read/write the local filesystem
# under this root instead of GCS. Leave unset in prod.
# DEV_FS_ROOT=/tmp/annemusic-dev

# ---------- apps/api (port 8082 by default) ----------
GCP_PROJECT=your-gcp-project
GCP_REGION=europe-west1
CORS_ORIGINS=*
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your-qstash-token
ORCHESTRATOR_URL=https://annemusic-orchestrator-xxxxx.a.run.app

# /manual harness gate. Outside local dev the /manual/* routes are disabled
# unless this is set; the browser UI prompts for it once and sends it as
# x-manual-key. Generate: openssl rand -hex 16
# MANUAL_TOKEN=

# Stage URLs: used by both the orchestrator (context.call) and the /manual
# test harness (via apps/api/src/stage-proxy.ts). Set to localhost for local
# dev, or the Cloud Run service URLs after `bash infra/deploy-stage.sh`.
SEPARATE_URL=http://localhost:8101
TRANSCRIBE_URL=http://localhost:8102
ALIGN_URL=http://localhost:8103
COMPOSE_URL=http://localhost:8104
RECORD_MIX_URL=http://localhost:8105

# ---------- apps/orchestrator (port 8090 by default) ----------
# Reads the same UPSTASH_REDIS_REST_* + stage URLs as apps/api.

# ---------- stages/* (per-stage, but identical schema) ----------
# Each Python stage reads UPSTASH_REDIS_REST_URL/_TOKEN + GCS_BUCKET.
# Transcribe: override the whisper fallback model / device if needed.
# WHISPER_MODEL=large-v3-turbo
# TRANSCRIBE_DEVICE=cuda:0   # cuda:0 | mps | cpu
# QWEN3_MODEL=Qwen/Qwen3-ASR-1.7B

# Align: override only for debugging.
# Separate: SEPARATE_MODEL=mel_band_roformer_kim (default)
#   | bs_roformer_ep317 | htdemucs | htdemucs_ft | htdemucs_6s
