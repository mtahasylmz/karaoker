# Keep Cloud Build context small. Everything listed here is excluded from
# the build context sent to `gcloud builds submit` — saves minutes on every
# deploy.
**/.venv
**/node_modules
**/.DS_Store
**/__pycache__
**/*.pyc
**/.pytest_cache

# Local dev state + ephemeral outputs.
/tmp
**/dist
**/*.log

# Tooling caches.
/.claude
/.claude-code
**/.cache
/out

# VCS + editor junk.
/.git
/.gitignore
**/.idea
**/.vscode

# Sample media + bench fixtures — large and not needed in the image.
/sample-music
**/bench/fixtures
**/bench/results

# Docs aren't needed at runtime.
**/*.md
!stages/*/CLAUDE.md
